# YiHangAI production environment template
#
# Usage:
#   cp .env.example .env.production
#   edit .env.production
#   bash scripts/deploy-prod.sh
#
# This file is for production Docker Compose deployment.
# For local development, use .env.local instead.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# The default password is allowed for quick deployment. Change it before public
# production use if you need stronger isolation.
POSTGRES_USER=starai
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=starai
DATABASE_URL=postgres://starai:change_this_to_a_strong_password@postgres:5432/starai?sslmode=disable

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=1gb

# -----------------------------------------------------------------------------
# Optional internal SearXNG search
# -----------------------------------------------------------------------------
# Disabled by default. When enabled, deploy-prod.sh starts the private
# Docker-only service. In admin use base URL: http://searxng:8080
SEARXNG_ENABLED=false
SEARXNG_VERSION=latest
SEARXNG_SECRET=replace_with_a_random_internal_search_secret
SEARXNG_MEMORY_LIMIT=768m
SEARXNG_CPUS=1.0

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Defaults are allowed for quick deployment. Change both secrets before public
# production use because JWT secrets protect login tokens.
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_JWT_SECRET=replace_with_another_long_random_secret
# Must be identical in API and Worker. Do not rotate it without re-encrypting
# stored model route keys first.
MODEL_ROUTE_CIPHER_KEY=replace_with_a_stable_32_plus_character_secret
JWT_EXPIRE_HOURS=72

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
APP_ENV=production
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
API_PORT=8080
BASE_URL=https://yourdomain.com

# Local upload fallback. Production should prefer R2/S3.
LOCAL_STORAGE_DIR=
LOCAL_STORAGE_PUBLIC_URL=https://yourdomain.com/uploads-local
# Optional container-internal URL used by API-side media checks when the public URL is host-only.
LOCAL_STORAGE_INTERNAL_URL=

# Optional self-hosted Douyin_TikTok_Download_API endpoint (v1 parse API).
# Leave empty to use the built-in public resolver endpoint.
# HTTP API base, for example https://api.douyin.wtf or http://douyin-api:8000
DOUYIN_API_BASE=
# API key for a private parser instance. Empty = sign in with the demo account.
DOUYIN_API_KEY=
# Legacy: full resolver endpoint from older deployments. Only the origin is used.
DOUYIN_RESOLVER_URL=

# Optional local yt-dlp executable path for social video URL imports.
# The API Docker image already includes it.
YTDLP_PATH=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://yourdomain.com

# 图片 CDN 域名（逗号分隔，构建时内联）。配置后灵感广场列表自动改用
# CDN 侧缩略图（腾讯云数据万象 imageMogr2），未配置则保持原图不变。
# 例：img.yourdomain.com
NEXT_PUBLIC_MEDIA_CDN_HOSTS=

# Admin static assets for single-domain deployment.
# Must match the Nginx /admin-assets/_next/ rule.
ADMIN_ASSET_PREFIX=/admin-assets

# -----------------------------------------------------------------------------
# R2 / S3 compatible storage
# -----------------------------------------------------------------------------
# 方案 A：MinIO / Cloudflare R2（公开地址带 bucket 前缀）
#   MINIO_PUBLIC_URL=https://cdn.yourdomain.com
#   最终对象地址：https://cdn.yourdomain.com/starai-works/<key>
MINIO_ENDPOINT=<accountid>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=your_r2_access_key
MINIO_SECRET_KEY=your_r2_secret_key
MINIO_BUCKET=starai-works
MINIO_PUBLIC_URL=https://cdn.yourdomain.com
MINIO_USE_SSL=true

# 方案 B：腾讯云 COS 私有桶 + 自定义 CDN 加速域名
#   COS 的 CDN/源站域名直接映射对象，公开地址不带 bucket 前缀：
#   https://img.yourdomain.com/<key>
# 详细步骤见 docs/cos-cdn-setup.md
# MINIO_ENDPOINT=cos.ap-hongkong.myqcloud.com
# MINIO_REGION=ap-hongkong
# MINIO_ACCESS_KEY=<子账号 SecretId>
# MINIO_SECRET_KEY=<子账号 SecretKey>
# MINIO_BUCKET=yami-media-1250000000
# MINIO_PUBLIC_URL=https://img.yourdomain.com
# MINIO_USE_SSL=true
# MINIO_PUBLIC_URL_STYLE=object
# MINIO_BUCKET_PRIVATE=true
# MINIO_SKIP_BUCKET_INIT=true
# COS 必须用虚拟主机风格；新代码按 *.myqcloud.com 自动识别，旧镜像显式写 dns
# MINIO_BUCKET_LOOKUP=dns

# bucket：<公开域名>/<bucket>/<key>（默认，兼容 MinIO/R2 历史数据）
# object：<公开域名>/<key>（COS 自定义 CDN/源站域名）
MINIO_PUBLIC_URL_STYLE=bucket
# 私有读桶：不写入“公有读”桶策略
MINIO_BUCKET_PRIVATE=false
# 跳过启动时的 BucketExists/MakeBucket（COS 在控制台建桶，子账号通常无桶级权限）
MINIO_SKIP_BUCKET_INIT=false
# S3 V4 签名地域，留空时自动探测；COS 建议显式填写，如 ap-hongkong
MINIO_REGION=
# S3 请求风格：auto（默认）/ path / dns（虚拟主机风格）。
# 腾讯云 COS 强制虚拟主机风格，代码会对 *.myqcloud.com 自动使用 dns。
MINIO_BUCKET_LOOKUP=auto

# -----------------------------------------------------------------------------
# Model gateway
# -----------------------------------------------------------------------------
NEW_API_BASE_URL=https://your-model-gateway.example.com
NEW_API_TOKEN=your_model_gateway_token
NEW_API_TIMEOUT_SECONDS=300
NEW_API_STREAM_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
# 并发任务数（含图片/视频/工作流）。异步轮询任务大部分时间在等待，
# 可适当调大；注意上游渠道的限流。
# 数据库连接池会按 2*并发+4 自动扩容，无需单独配置。
WORKER_CONCURRENCY=20
# 异步任务默认轮询超时（秒）。单模型可在 runtime_rule.upstream.poll_timeout_sec 覆盖。
WORKER_POLL_TIMEOUT_SEC=900

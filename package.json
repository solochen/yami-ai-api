{
  "name": "star-ai-platform",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev:web": "pnpm --filter @starai/web dev",
    "dev:admin": "pnpm --filter @starai/admin dev",
    "build:web": "pnpm --filter @starai/web build",
    "build:admin": "pnpm --filter @starai/admin build",
    "gallery:coverage": "node scripts/analyze-gallery-coverage.js",
    "gallery:specs": "node scripts/generate-gallery-case-specs.js",
